{
  "sections": {
    "weather": {
      "title": "Clima (/api/weather)",
      "strategy": "Fallback secuencial: Open-Meteo → Gael Cloud → Boostr",
      "role": "primary",
      "sources": [
        {
          "name": "Open-Meteo",
          "url": "https://open-meteo.com/",
          "role": "primary",
          "license": "CC BY 4.0",
          "note": "api.open-meteo.com/v1/forecast, todas las ciudades en una llamada, timeout 8s"
        },
        {
          "name": "Gael Cloud",
          "url": "https://api.gael.cloud/#todos-los-climas",
          "role": "fallback",
          "license": "API pública — sin licencia explícita",
          "note": "api.gael.cloud/general/public/clima/{ICAO}, timeout 8s"
        },
        {
          "name": "Boostr",
          "url": "https://docs.boostr.cl/reference/weather-code",
          "role": "fallback",
          "license": "API pública — sin licencia explícita",
          "note": "api.boostr.cl/weather/{ICAO}.json, timeout 5s"
        },
        {
          "name": "Open-Meteo Geocoding",
          "url": "https://open-meteo.com/en/docs/geocoding-api",
          "role": "single",
          "license": "CC BY 4.0 (datos GeoNames)",
          "note": "búsqueda y geolocalización inversa en el widget de clima"
        },
        {
          "name": "DMC",
          "url": "https://www.meteochile.gob.cl/",
          "role": "single",
          "license": "Datos públicos del Estado — sin licencia explícita",
          "note": "pronostico.js (5 días, ~60 ciudades) vía /api/forecast"
        },
        {
          "name": "Windy",
          "url": "https://www.windy.com/",
          "role": "single",
          "license": "Embed gratuito con atribución",
          "note": "mapa de radar y precipitación embebido"
        }
      ]
    },
    "emergency": {
      "title": "Sismos / Emergencias (/api/emergency)",
      "strategy": "Fallback secuencial (magnitud mínima 5.0; pasa al siguiente si items.length === 0)",
      "role": "primary",
      "sources": [
        {
          "name": "Gael Cloud",
          "url": "https://api.gael.cloud",
          "role": "primary",
          "license": "API pública — sin licencia explícita",
          "note": "api.gael.cloud/general/public/sismos, timeout 10s; los datos provienen del CSN"
        },
        {
          "name": "Boostr",
          "url": "https://docs.boostr.cl",
          "role": "fallback",
          "license": "API pública — sin licencia explícita",
          "note": "api.boostr.cl/earthquakes/recent.json, timeout 10s; añade coordenadas"
        },
        {
          "name": "USGS",
          "url": "https://earthquake.usgs.gov",
          "role": "fallback",
          "license": "Dominio público (USGS)",
          "note": "earthquake.usgs.gov/.../2.5_day.geojson, filtrado a Chile/Sudamérica, timeout 10s"
        },
        {
          "name": "CSN (U. de Chile)",
          "url": "https://www.csn.uchile.cl/",
          "role": "single",
          "license": "Datos públicos — sin licencia explícita",
          "note": "origen de los datos sísmicos; enlace de cada sismo (no se consulta directamente)"
        }
      ]
    },
    "senapred": {
      "title": "Alertas SENAPRED (canal independiente)",
      "strategy": "Única fuente",
      "role": "single",
      "sources": [
        {
          "name": "Telegram SenapredChile",
          "url": "https://t.me/s/SenapredChile",
          "role": "single",
          "license": "Canal oficial público — sin licencia explícita",
          "note": "scraping de t.me/s/SenapredChile (BROWSER_UA); parsea .js-widget_message (data-post, <time datetime>, .js-message_text); severidad por keyword (desborde/aluvión/evacuar→critical, crecida/incendio/SAE/alerta→high, preventivo/monitoreo→moderate, else low)"
        }
      ]
    },

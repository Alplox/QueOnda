---
import { Header } from '../components/layout/Header';
import { SideIndex } from '../components/layout/SideIndex';
import { BottomNav } from '../components/layout/BottomNav';
import { Footer } from '../components/layout/Footer';
import { BackToTop } from '../components/layout/BackToTop';
import { Section } from '../components/layout/Section';
import { SectionShareHandler } from '../components/layout/SectionShareHandler';
import { FinanceWidget } from '../components/widgets/FinanceWidget';
import { FiestasCountdown } from '../components/widgets/FiestasCountdown';
import { YouTubeTrends } from '../components/widgets/YouTubeTrends';
import { SpotifyChart } from '../components/widgets/SpotifyChart';
import { GoogleTrendsWidget } from '../components/widgets/GoogleTrendsWidget';
import { WeatherWidget } from '../components/widgets/WeatherWidget';
import { TransportWidget } from '../components/widgets/TransportWidget';
import { AirQualityWidget } from '../components/widgets/AirQualityWidget';
import { FootballTable } from '../components/widgets/FootballTable';
import { JobList } from '../components/widgets/JobList';
import { EmergencyWidget } from '../components/widgets/EmergencyWidget';
import { EmergencyTicker } from '../components/widgets/EmergencyTicker';
import { HolidaysWidget } from '../components/widgets/HolidaysWidget';
import { ClientNewsFeed } from '../components/news/ClientNewsFeed';
import { ClientTV } from '../components/tv/ClientTV';
import { ClientRadios } from '../components/radio/ClientRadios';
import '../styles/global.css';
import { getTodayBg } from '../lib/backgrounds';
import { getTodayFestivity } from '../lib/festivities';
import { emojiToPath } from '../lib/emoji';
import { ClientRouter } from 'astro:transitions';

const hour = new Date().toLocaleString('en-US', { hour: 'numeric', hour12: false, timeZone: 'America/Santiago' });
const dayOfWeek = new Date().toLocaleString('en-US', { weekday: 'long', timeZone: 'America/Santiago' });
const todayBg = getTodayBg();
const festivity = getTodayFestivity();
const nightGreetings = ['¿Mucho café?', 'Anda acostarte wn', '¿No funcionó contar ovejas?'];
const greeting = festivity?.message ?? (dayOfWeek === 'Monday' && Number(hour) === 10 ? 'Se me hizo larga esta semana' : Number(hour) === 23 ? 'A trabajar con el nóctulo' : Number(hour) < 6 ? nightGreetings[Math.floor(Math.random() * nightGreetings.length)] : Number(hour) < 12 ? 'Buenos días' : Number(hour) < 19 ? 'Buenas tardes' : 'Buenas noches');

const SITE_TITLE = '¿Qué Onda? - Chile en una sola página';
const SITE_DESCRIPTION = 'Noticias, TV en vivo, radios, finanzas, clima y más de Chile en un solo lugar. Sin anuncios, sin ruido.';
---

<!doctype html>
<html lang="es-CL" data-theme="halloween">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="canonical" href="https://queonda.pages.dev" />
    <meta property="og:title" content="¿Qué Onda? - Chile en una sola página" />
    <meta property="og:description" content="Noticias, TV en vivo, radios, finanzas, clima y más de Chile en un solo lugar. Sin anuncios, sin ruido." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://queonda.pages.dev" />
    <meta property="og:image" content="https://queonda.pages.dev/og-image.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="¿Qué Onda? - Chile en una sola página con noticias, TV en vivo, radios, finanzas y clima" />
    <meta property="og:site_name" content="¿Qué Onda?" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="¿Qué Onda? - Chile en una sola página" />
    <meta name="twitter:description" content="Noticias, TV en vivo, radios, finanzas, clima y más de Chile en un solo lugar. Sin anuncios, sin ruido." />
    <meta name="twitter:image" content="https://queonda.pages.dev/og-image.webp" />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="630" />
    <meta name="twitter:image:alt" content="¿Qué Onda? - Chile en una sola página con noticias, TV en vivo, radios, finanzas y clima" />
    <meta name="twitter:site" content="@queonda" />
    <script is:inline type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://queonda.pages.dev/#website","name":"¿Qué Onda?","url":"https://queonda.pages.dev","description":"Noticias, TV en vivo, radios, finanzas, clima y más de Chile en un solo lugar.","inLanguage":"es-CL","publisher":{"@id":"https://queonda.pages.dev/#organization"}},{"@type":"Organization","@id":"https://queonda.pages.dev/#organization","name":"¿Qué Onda?","url":"https://queonda.pages.dev","logo":"https://queonda.pages.dev/android-chrome-512x512.png","sameAs":["https://github.com/Alplox/QueOnda"]},{"@type":"WebApplication","@id":"https://queonda.pages.dev/#app","name":"¿Qué Onda?","url":"https://queonda.pages.dev","applicationCategory":"NewsApplication","operatingSystem":"Web","browserRequirements":"Requires JavaScript","inLanguage":"es-CL","isAccessibleForFree":true,"description":"Agregador de noticias chileno con TV y radio en vivo, clima, finanzas, transporte y deportes en un dashboard de una sola página, sin anuncios.","offers":{"@type":"Offer","price":"0","priceCurrency":"CLP"}}]}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <style>@font-face{font-family:'Figtree Fallback';src:local('Arial');size-adjust:107%;ascent-override:91%;descent-override:22%;line-gap-override:0%}</style>
    <link rel="preload" as="image" href={todayBg.url} fetchpriority="high" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&amp;family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;display=swap"
      media="print"
      onload="this.setAttribute('media','all')"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&amp;family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;display=swap" />
    </noscript>
    <script>
      (function(){var s=localStorage.getItem('theme')||'halloween';document.documentElement.setAttribute('data-theme',s);document.documentElement.classList.toggle('light-theme',getComputedStyle(document.documentElement).colorScheme.includes('light'));})();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-base-100 text-base-content min-h-screen pt-14">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-primary focus:text-primary-content focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg"
    >Ir al contenido</a>
    <svg style="position:absolute;width:0;height:0" aria-hidden="true">
      <filter id="paper-grain">
        <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </svg>

    <Header client:load />

    <SideIndex client:load />

    <BottomNav client:load />

    <EmergencyTicker client:load />

    <main id="main" class="max-w-7xl mx-auto px-4 py-6 pb-56 space-y-8 md:space-y-12">
      <!-- Hero -->
      <section class="hero-stage relative overflow-hidden text-center py-32 md:py-40 rounded-t-2xl" data-collapsed="false">
        <div class="absolute inset-0 animate-[heroBgIn_0.8s_ease-out] will-animate">
          <img
            src={todayBg.url}
            alt=""
            class="w-full h-full object-cover"
            style={`object-position: ${todayBg.focalPoint ?? 'center'}`}
            loading="eager"
            fetchpriority="high"
          />
          <div class="hero-scrim absolute inset-0 bg-gradient-to-b from-base-100/25 via-base-100/30 to-base-100/70" />
        </div>
        <div class="hero-fade absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-base-100 to-transparent" />
        <button
          type="button"
          class="hero-toggle absolute top-4 right-4 z-20 grid place-items-center w-9 h-9 rounded-full backdrop-blur-sm bg-base-100/40 hover:bg-base-100/70 border border-base-300/20 text-base-content/80 hover:text-base-content transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          aria-expanded="true"
          aria-label="Ocultar portada para ver la foto"
          data-collapsed="false"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 12s4-7.5 11-7.5S23 12 23 12s-4 7.5-11 7.5S1 12 1 12Z" />
            <circle cx="12" cy="12" r="3.2" />
            <line class="hero-toggle-slash" x1="2.2" y1="2.2" x2="21.8" y2="21.8" />
          </svg>
        </button>
        <div class="hero-card-wrap relative z-10 max-w-2xl mx-auto px-4">
          <div class={`hero-card overflow-hidden backdrop-blur-sm bg-base-100/50 rounded-2xl p-8 md:p-12 shadow-xl border border-base-300/20 ${festivity?.theme ?? ''}`}>
            <div class="flex justify-center mb-5 animate-[fadeSlideIn_0.5s_ease-out_0.3s_both] will-animate">
              <div class="bg-base-100/80 backdrop-blur-sm text-base-content text-sm font-semibold px-4 py-1.5 rounded-xl whitespace-nowrap">
                {festivity?.flagSvg ? <img src={festivity.flagSvg} alt="" class="inline-block h-[1em] align-text-bottom mr-1" /> : festivity?.emoji ? <img src={emojiToPath(festivity.emoji)} alt="" class="inline-block h-[1em] align-text-bottom mr-1" /> : ''}{greeting}
              </div>
            </div>
<h1 class="hero-title text-[clamp(2rem,8vw,3rem)] md:text-[clamp(2.5rem,6vw,4.5rem)] lg:text-[clamp(3rem,5vw,6rem)] font-extrabold tracking-tighter leading-none text-base-content mb-4 text-nowrap animate-[heroScaleIn_0.6s_cubic-bezier(0.16,1,0.3,1)_0.5s_both] will-animate">
  <span class="text-primary inline-block animate-[float_3s_ease-in-out_infinite]">¿</span>
  Qué Onda
  <span class="text-primary inline-block animate-[float_3s_ease-in-out_infinite_0.5s]">?</span>
</h1>
            <p class="text-base md:text-lg max-w-lg mx-auto text-base-content/80 animate-[heroFadeUp_0.6s_ease-out_0.7s_both] will-animate">
              Chile en una sola página.
            </p>
            <p class="text-sm mt-3 max-w-lg mx-auto text-base-content/60 animate-[heroFadeUp_0.6s_ease-out_0.85s_both] will-animate">
              Noticias, TV, radios, tendencias y más.
            </p>
          </div>
        </div>
        <div class="absolute bottom-3 right-4 z-10 animate-[heroFadeUp_0.5s_ease-out_1s_both]">
          <span class="backdrop-blur-sm bg-base-100/30 rounded-lg px-2.5 py-1 text-[10px] text-base-content/50">
            Foto:{' '}
            <a href={todayBg.photoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-base-content underline underline-offset-2 transition-colors">{todayBg.author}</a>
          </span>
        </div>
        <button
          type="button"
          class="hero-island absolute left-4 bottom-3 z-10 flex items-center rounded-full backdrop-blur-sm bg-base-100/60 hover:bg-base-100/80 border border-base-300/20 px-4 py-2 shadow-lg text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          aria-label="Mostrar portada"
          inert
        >
          <span class="text-sm font-extrabold tracking-tighter whitespace-nowrap">
            <span class="text-primary">¿</span>Qué Onda<span class="text-primary">?</span>
          </span>
        </button>
      </section>

      <script is:inline>
        (function () {
          function initHero() {
            var hero = document.querySelector('.hero-stage');
            if (!hero) return;
            var btn = hero.querySelector('.hero-toggle');
            var island = hero.querySelector('.hero-island');
            var wrap = hero.querySelector('.hero-card-wrap');
            var card = hero.querySelector('.hero-card');
            if (!btn || !island || !wrap || !card || btn.dataset.bound === '1') return;
            btn.dataset.bound = '1';

            var KEY = 'hero-collapsed';

            // Geometry for the collapse: how far the card's bottom-left corner must travel
            // to land on the island, and the island's box so the clip ends as its pill.
            // Both boxes are state-independent (the island enters by opacity alone), and the
            // wrapper's transform is read back from the live matrix — so this stays exact even
            // when called mid-transition (fonts finishing, a resize during the animation).
            function measure() {
              var t = getComputedStyle(wrap).transform;
              var m = null;
              if (t && t !== 'none') {
                try { m = new DOMMatrixReadOnly(t); } catch (e) { m = null; }
              }
              var dx = m ? m.m41 : 0;
              var dy = m ? m.m42 : 0;

              var c = card.getBoundingClientRect();
              var i = island.getBoundingClientRect();

              hero.style.setProperty('--hero-tx', (i.left - (c.left - dx)) + 'px');
              hero.style.setProperty('--hero-ty', (i.bottom - (c.bottom - dy)) + 'px');
              hero.style.setProperty('--hero-isl-w', i.width + 'px');
              hero.style.setProperty('--hero-isl-h', i.height + 'px');
              hero.style.setProperty('--hero-isl-r', (i.height / 2) + 'px');
            }

            function set(collapsed) {
              hero.dataset.collapsed = collapsed ? 'true' : 'false';
              btn.dataset.collapsed = collapsed ? 'true' : 'false';
              btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
              btn.setAttribute('aria-label', collapsed ? 'Mostrar portada' : 'Ocultar portada para ver la foto');
              island.inert = !collapsed;
            }

            var stored = '0';
            try { stored = localStorage.getItem(KEY) || '0'; } catch (e) {}
            measure();
            set(stored === '1');

            // Reading a layout property forces a style flush, so the "before-change" style already
            // carries the measured vars and the applied state. Adding `.hero-ready` after that only
            // introduces the transition properties — no value changes, so a persisted collapsed
            // state paints at rest instead of animating on boot.
            void hero.offsetHeight;
            hero.classList.add('hero-ready');

            // Web fonts change the card/island boxes — re-measure once they are in
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);

            function toggle() {
              var next = hero.dataset.collapsed !== 'true';
              // The vars only matter while collapsed, and the geometry is the expanded card's,
              // so only the way in needs a (re)measure — the way out just reuses them.
              if (next) measure();
              set(next);
              try { localStorage.setItem(KEY, next ? '1' : '0'); } catch (e) {}
            }

            btn.addEventListener('click', toggle);
            island.addEventListener('click', toggle);
            window.addEventListener('resize', measure);
          }

          initHero();
          document.addEventListener('astro:page-load', initHero);
        })();
      </script>

      <!-- Emergencia -->
      <SectionShareHandler client:idle />
      <EmergencyWidget client:load />

      <!-- Noticias -->
      <Section id="noticias" title="Noticias" subtitle="Agrupadas por tema y medio">
        <ClientNewsFeed client:idle />
      </Section>

      <!-- TV en Vivo -->
      <Section id="tv" title="TV en Vivo" subtitle="Canales chilenos en tiempo real">
        <ClientTV client:idle />
      </Section>

      <!-- Radios -->
      <Section id="radios" title="Radios" subtitle="Radios chilenas en vivo">
        <ClientRadios client:idle />
      </Section>

      <!-- Finanzas -->
      <Section id="finanzas" title="Finanzas" subtitle="Indicadores económicos">
        <FinanceWidget client:idle />
      </Section>

      <!-- YouTube Trends -->
      <Section id="youtube" title="YouTube Chile" subtitle="Últimos videos de canales chilenos">
        <YouTubeTrends client:idle />
      </Section>

      <!-- Spotify -->
      <Section id="spotify" title="Spotify Top 50" subtitle="Lo más escuchado en Chile">
        <SpotifyChart client:idle />
      </Section>

      <!-- Google Trends -->
      <Section id="tendencias-web" title="Google Trends" subtitle="Búsquedas del momento en Chile">
        <GoogleTrendsWidget client:idle />
      </Section>

      <!-- Clima -->
      <Section id="clima" title="Clima" subtitle="Pronóstico para Chile">
        <WeatherWidget client:idle />
      </Section>

      <!-- Calidad del Aire -->
      <Section id="aire" title="Calidad del Aire" subtitle="Estaciones SINCA en tiempo real">
        <AirQualityWidget client:idle />
      </Section>

      <!-- Transporte -->
      <Section id="transporte" title="Transporte" subtitle="Metro y buses en tiempo real (Santiago)">
        <TransportWidget client:idle />
      </Section>

      <!-- Deportes -->
      <Section id="deportes" title="Deportes" subtitle="Noticias del fútbol chileno">
        <FootballTable client:idle />
      </Section>

      <!-- Trabajos -->
      <Section id="trabajos" title="Trabajos" subtitle="Ofertas laborales en Chile">
        <JobList client:idle />
      </Section>

      <!-- Feriados -->
      <Section id="feriados" title="Feriados" subtitle="Calendario de feriados en Chile">
        <HolidaysWidget client:idle />
      </Section>

      <!-- Fiestas Patrias -->
      <Section id="fiestas-patrias" title="Fiestas Patrias" subtitle="Cuenta regresiva para el 18 de septiembre">
        <FiestasCountdown client:idle />
      </Section>
    </main>

    <Footer client:idle />
    <BackToTop client:load />

    <script>
      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          e.preventDefault();
          const href = anchor.getAttribute('href');
          if (!href) return;
          const target = document.querySelector(href);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    </script>

    <script is:inline>
      // Section entrance animation — one-shot data-visible on scroll
      // ponytail: astro:page-load re-fires after View Transitions (e.g. nav to /todas-las-fuentes and back)
      document.addEventListener('astro:page-load', function() {
        var observer = new IntersectionObserver(function(entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              entries[i].target.setAttribute('data-visible', 'true');
              observer.unobserve(entries[i].target);
            }
          }
        }, { rootMargin: '-80px 0px -20% 0px' });
        document.querySelectorAll('section[id]').forEach(function(s) { observer.observe(s); });
      });
    </script>

    <script>
      // Pre-warm server cache: all API routes, so the edge cache is hot before widgets hydrate
      (function() {
        var endpoints = [
          '/api/emergency',
          '/api/power',
          '/api/news?mode=inventory',
          '/api/channels?source=json-teles',
          '/api/channels?source=iptv-org',
          '/api/channels?source=mi-iptv',
          '/api/radio-stations',
          '/api/youtube',
          '/api/trends',
          '/api/transport',
          '/api/air-quality',
          '/api/sports',
          '/api/futbol',
          '/api/jobs',
          '/api/spotify',
        ];
        // ponytail: all at rAF — fire-and-forget fetches are negligible, idle scheduling
        // delayed cache warming past the point client:idle widgets hydrate on fast scroll
        if ('requestAnimationFrame' in window) {
          requestAnimationFrame(function() {
            for (var i = 0; i < endpoints.length; i++) {
              try { fetch(endpoints[i]); } catch(e) {}
            }
          });
        } else {
          for (var i = 0; i < endpoints.length; i++) {
            try { fetch(endpoints[i]); } catch(e) {}
          }
        }
      })();
    </script>
  </body>
</html>
